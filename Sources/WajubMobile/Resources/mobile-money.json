  "algorithms": {
    "sanitize": "Keep the characters 0-9 and '+'; then remove every '+'.",
    "national_digits": "sanitize(input); if the result starts with the country's dial_code digits (without '+'), remove them; then remove every leading '0'; then, in a country with earlier_number, digits of earlier_number.length that start with one of earlier_number.starts_with take earlier_number.prefix in front (Benin, 8 digits before 30 Nov 2024: '96 12 34 56' -> '196123456').",
    "validate": "If national_number_length is set: national_digits must have exactly that many digits, and, in a country with earlier_number, start with earlier_number.prefix. Otherwise: sanitize(input) must be 7 to 15 digits.",
    "detect_operator": "Evaluate prefix_rules in order against national_digits — in a country with earlier_number, digits that do not start with earlier_number.prefix are read with it in front, so a number typed the earlier way names its operator as it is typed ('96' -> '196'); the first rule with a starts_with entry that the digits start with wins. No rule, or no match: null. Wallets held whatever the operator (operator_independent_wallets) are never detected.",
    "e164": "dial_code + (e164_trunk_zero == 'keep' ? '0' : '') + national_digits. 'keep' marks a plan whose leading 0 is part of the number (Côte d'Ivoire, Benin): national_digits, national_number_length and the prefix rules leave it out, as for every other country, and E.164 puts it back.",
    "format_as_you_type": "Digits only (no '+'), at most 15, grouped by two with single spaces: '671234567' -> '67 12 34 56 7'.",
    "brand_fallback": "When an operator has no usable logo URL, draw a round badge with brand.background, brand.color and brand.mark (else the first 8 alphanumerics of brand.label, upper-cased). No brand entry: background #525252, color #ffffff, label from the channel name."
  },
  "fallback_brand": {
    "color": "#ffffff",
    "background": "#525252"
  },
  "loose_length": {
    "min": 7,
    "max": 15
  },
