  "errata": [
    {
      "country": "CI",
      "field": "e164_trunk_zero",
      "value": "keep",
      "web_behaviour": "checkout.wajub drops every leading 0 and sends +225 followed by 9 digits (e.g. 07 01 02 03 04 -> +225701020304).",
      "why_mobile_differs": "Since 31 Jan 2021 Ivorian numbers have 10 digits whose leading 0 is significant (+225 07 01 02 03 04); api.wajub's sandbox CI prefixes (+22505 MTN, +22507 Orange, +22501 Moov, +22503 Wave, config/sandbox.php:19-25) and libphonenumber both expect it. Detection and the length check stay on national_digits (web parity); only the E.164 sent keeps the 0."
    },
    {
      "country": "BJ",
      "field": "e164_trunk_zero",
      "value": "drop",
      "web_behaviour": "Same as the web. Open question: the web placeholder (0190123456) is Benin's 10-digit plan (since Nov 2024), whose leading 01 the normalisation breaks (+229190123456), while api.wajub's sandbox BJ prefixes (+22990, +22991, +22997) are the old 8-digit plan.",
      "why_mobile_differs": "It does not, until api.wajub and checkout.wajub agree."
    },
    {
      "countries": [
        "MW",
        "ET",
        "CD",
        "NE"
      ],
      "field": "dial_code",
      "web_behaviour": "Absent from checkout's COUNTRIES: the web sends national digits with no '+' and no dial code for these.",
      "why_mobile_differs": "ITU dial codes added (dial_code_source: itu) so the E.164 sent is valid."
    }
  ],
