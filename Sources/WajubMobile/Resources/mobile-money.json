  "algorithms": {
    "sanitize": "Keep the characters 0-9 and '+'; then remove every '+'.",
    "national_digits": "sanitize(input); if the result starts with the country's dial_code digits (without '+'), remove them; then remove every leading '0'.",
    "validate": "If national_number_length is set: national_digits must have exactly that many digits. Otherwise: sanitize(input) must be 7 to 15 digits.",
    "detect_operator": "Evaluate prefix_rules in order against national_digits; the first rule with a starts_with entry that national_digits starts with wins. No rule, or no match: null. Wallets held whatever the operator (operator_independent_wallets) are never detected.",
    "e164": "dial_code + (e164_trunk_zero == 'keep' ? '0' : '') + national_digits",
    "format_as_you_type": "Digits only (no '+'), at most 15, grouped by two with single spaces: '671234567' -> '67 12 34 56 7'.",
    "brand_fallback": "When an operator has no usable logo URL, draw a round badge with brand.background, brand.color and brand.mark (else the first 8 alphanumerics of brand.label, upper-cased). No brand entry: background #525252, color #ffffff, label from the channel name."
  },
